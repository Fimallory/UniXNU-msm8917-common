# MSM8917 SoC kernel configuration fragment.
# arch:configs/common.config supplies the generic ARM64 options.
# Cortex-A53 is ARMv8.0; do not inherit the ARMv8.1 PAN enable path.
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# BCM2837 is only the XNU build personality, not the panic-log RAM layout.
# Select the existing validated DT path; no supplied pram means no old-log probe.
CONFIG_XNU_DT_PANIC_REGION=y
